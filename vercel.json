{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(admin|slayd|skript)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/bot.js": {
      "maxDuration": 60
    },
    "api/mgr-morning.js": {
      "maxDuration": 60
    },
    "api/mgr-evening.js": {
      "maxDuration": 60
    },
    "api/sahifa.js": {
      "includeFiles": "{index.html,essays.js,kitoblar.js,assets/og/*.png}"
    },
    "api/sitemap.js": {
      "includeFiles": "essays.js"
    }
  },
  "crons": [
    {
      "path": "/api/mgr-morning",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/mgr-evening",
      "schedule": "0 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/insho/:folio",
      "destination": "/api/sahifa?insho=:folio"
    },
    {
      "source": "/:s(kitoblar|yozgan-kitoblarim|dasturlar|murojaat|men-haqimda)",
      "destination": "/api/sahifa?s=:s"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ]
}
